# GAZE V2 needs no secret keys. These optional settings are environment
# variables. Set them in your terminal before `npm start` / `npm run dev`,
# or copy this file to .env and run: node --env-file=.env server/index.js

# Port and address for `npm start` (default 4173 on 127.0.0.1).
# Use HOST=0.0.0.0 to reach it from another device on your network
# (the camera then needs HTTPS, except on localhost).
PORT=4173
HOST=127.0.0.1

# Path to your own news feed list (same format as server/news-feeds.json).
# NEWS_FEEDS_FILE=/path/to/my-feeds.json

# ---- Sign-in (Supabase Auth) ----
# Needed for any website on the internet; without them a deployed site stays
# closed. On this computer (localhost) the app opens without sign-in when they
# are empty. Both values are public by design (Supabase "Project URL" and the
# "anon"/publishable key); never put the service_role key here.
# For `npm run dev` / `npm run build`, copy this file to .env and fill them in.
# On Netlify: Site configuration -> Environment variables.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
